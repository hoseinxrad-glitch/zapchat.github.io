# ZapChat Environment Variables

# ============================================================
# Database (required)
# For local dev: SQLite (default)
# For production: PostgreSQL
# ============================================================
# Local SQLite:
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Production PostgreSQL (from Render):
# DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public"

# ============================================================
# Auth (required)
# Generate with: openssl rand -hex 32
# ============================================================
AUTH_SECRET="zapchat-dev-secret-change-in-production-2026"

# ============================================================
# Public URLs (required for production, optional for dev)
# ============================================================
# Your deployed frontend URL (e.g., GitHub Pages URL or custom domain)
NEXT_PUBLIC_APP_URL=""

# Your WebSocket server URL (Render URL of the chat-service)
# In dev, the dev server proxies to localhost:3003 via Caddy
# In prod, set this to: https://your-app-name.onrender.com
NEXT_PUBLIC_SOCKET_URL=""

# ============================================================
# For GitHub Pages deployment only
# ============================================================
# The repo name (e.g., /zapchat if your repo is username/zapchat)
NEXT_BASE_PATH=""
NEXT_ASSETS_PREFIX=""

# ============================================================
# Optional
# ============================================================
# Maximum upload size (default: 100MB)
# MAX_UPLOAD_SIZE=104857600

# Upload directory (default: ./uploads)
# UPLOAD_DIR=/data/uploads

# Admin bootstrap - first user to call /api/auth/claim-admin becomes admin
# Set to "false" to disable this endpoint in production (recommended for production)
# ALLOW_ADMIN_CLAIM=true
